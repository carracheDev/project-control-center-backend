# Local development
DATABASE_URL="file:./dev.db"
# PostgreSQL staging/production example (use this value instead of DATABASE_URL)
# DATABASE_URL="postgresql://pcc_staging:<password>@127.0.0.1:5432/pcc_staging?schema=public"
# Direct, non-pooled PostgreSQL URL used by Prisma migrations. In Neon, use the
# connection string without the "-pooler" host suffix.
# DIRECT_URL="postgresql://pcc_staging:<password>@127.0.0.1:5432/pcc_staging?schema=public"
FRONTEND_URL="http://localhost:3001"
PORT="3000"
JWT_SECRET=""
JWT_EXPIRES_IN="15m"
DEMO_ADMIN_EMAIL=""
DEMO_ADMIN_PASSWORD=""
EVIDENCE_STORAGE_DIR="./storage/evidence"
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"